[Unit]
Description=Barangay Tinurik Portal - Node.js Express REST API Service
Documentation=https://github.com/tinurik/barangay-portal
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/barangay-tinurik-portal/backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barangay_tinurik
Environment=JWT_SECRET=production_super_secret_tinurik_2026_change_me
Environment=FRONTEND_URL=http://<FRONTEND_PUBLIC_IP>
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=tinurik-backend

# Security Sandboxing options
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
