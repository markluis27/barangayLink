# Barangay Tinurik Portal - Backend Environment Variables

# Application Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Frontend Application Origin (For CORS policy)
# Local: http://localhost:3000
# AWS EC2: http://<FRONTEND_PUBLIC_IP>:3000 or http://<FRONTEND_PUBLIC_IP> (if port 80)
FRONTEND_URL=http://localhost:3000

# JSON Web Token Secret Key
# IMPORTANT: In production, change this to a secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=barangay_tinurik_portal_super_secure_jwt_secret_2026

# PostgreSQL Database Configuration
# Format: postgresql://username:password@hostname:5432/database_name
# For AWS RDS or local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barangay_tinurik

# Alternative individual PostgreSQL variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=barangay_tinurik

# Local Testing Fallback:
# If PostgreSQL is not installed locally, set USE_SQLITE=true to test immediately
USE_SQLITE=true
